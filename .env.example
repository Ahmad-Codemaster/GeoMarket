# Database
POSTGRES_USER=geomarket
POSTGRES_PASSWORD=geomarket_secret
POSTGRES_DB=geomarket_db

# Server
DATABASE_URL="postgresql://geomarket:geomarket_secret@localhost:5432/geomarket_db"
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=3600
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
